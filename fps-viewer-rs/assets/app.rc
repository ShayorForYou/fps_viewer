1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION {VERSION_4}
PRODUCTVERSION {VERSION_4}
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FPS Viewer"
      VALUE "FileDescription", "FPS Viewer"
      VALUE "FileVersion", "{VERSION}"
      VALUE "InternalName", "FpsViewer"
      VALUE "LegalCopyright", L"Copyright \x00A9 2026 FPS Viewer"
      VALUE "OriginalFilename", "FpsViewer.exe"
      VALUE "ProductName", "FPS Viewer"
      VALUE "ProductVersion", "{VERSION}"
      VALUE "Comments", "A featherweight frame-rate overlay for Windows."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
